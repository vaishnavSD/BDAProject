# =============================================================================
# Smart Inventory System — Environment Variables
# Copy this file to .env and fill in values before running docker-compose.
# Never commit .env to version control.
# =============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smart_inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory

# ── Kafka ────────────────────────────────────────────────────────────────────
# Use localhost:9092 when running producers on host machine.
# Use kafka:29092 when running producers inside Docker containers.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_LIVE_ORDERS=inventory-live-orders
KAFKA_TOPIC_LIVE_SHIPMENTS=inventory-live-shipments
KAFKA_TOPIC_LIVE_DISPATCHES=inventory-live-dispatches
KAFKA_TOPIC_ALERTS=inventory-alerts
KAFKA_TOPIC_DLQ=inventory-dlq

# ── Spark ────────────────────────────────────────────────────────────────────
SPARK_MASTER_URL=spark://localhost:7077
SPARK_CHECKPOINT_DIR=/opt/spark-checkpoints
SPARK_APP_NAME=SmartInventorySystem

# ── Data Paths ───────────────────────────────────────────────────────────────
RAW_DATA_BASE=./data/raw
REFERENCE_DATA_PATH=./data/raw/reference
TRANSACTION_DATA_PATH=./data/raw/transactions
HISTORICAL_DATA_PATH=./data/raw/historical
STREAMING_DATA_PATH=./data/raw/streaming

# ── Producer Settings ────────────────────────────────────────────────────────
# Delay in seconds between each row published to Kafka (simulates real time)
PRODUCER_DELAY_SECONDS=0.5
# Set to TRUE to loop the CSV endlessly; FALSE to publish once and exit
PRODUCER_LOOP=FALSE
